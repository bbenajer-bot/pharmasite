# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string.
#   Local dev:  postgres://<your-mac-username>@localhost:5432/pharmacy_site
#   Production: the Neon connection string (Neon dashboard -> Connect)
DATABASE_URL=

# Local only: the Neon (production) connection string, used to run migrations against production:
#   DATABASE_URL="$NEON_DATABASE_URL" pnpm payload migrate
# The live site also applies pending migrations itself on startup (prodMigrations in payload.config.ts).
NEON_DATABASE_URL=

# Long random string used to sign admin logins. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public URL of the site (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Added in later phases ---
# RESEND_API_KEY=          # Phase 3: order + prescription notification emails
# ADMIN_NOTIFY_EMAIL=      # Phase 3: where new-order / new-request alerts go
# R2_*                     # Phase 7: image storage in production

# Preview deployments only: "true" shows a "work in progress" banner and blocks search engines.
# Remove (or set to false) for the real launch.
NEXT_PUBLIC_PREVIEW_MODE=
