# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string.
#   Local dev:  postgres://<your-mac-username>@localhost:5432/pharmacy_site
#   Production: the Neon connection string (Neon dashboard -> Connect)
DATABASE_URL=

# Local only: the Neon (production) connection string, used to run migrations against production:
#   DATABASE_URL="$NEON_DATABASE_URL" pnpm payload migrate
# Netlify runs `pnpm ci` (migrate, then build), so new migrations reach Neon on every deploy.
NEON_DATABASE_URL=

# Long random string used to sign admin logins. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public URL of the site (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend, free tier). Leave RESEND_API_KEY empty in local dev: emails are printed to the
# server console instead of being sent. Staff notifications go to Shop Settings -> Notifications
# (falls back to the pharmacy email in Site Settings).
RESEND_API_KEY=
# Sender. Must be on a domain verified in Resend; onboarding@resend.dev works for testing only
# (Resend then only delivers to the Resend account owner's own address).
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Meridian Pharmacy
# Testing only: deliver every email to this address instead of the real recipient.
EMAIL_OVERRIDE_TO=

# --- Added in later phases ---
# R2_*                     # Phase 7: image storage in production

# Preview deployments only: "true" shows a "work in progress" banner and blocks search engines.
# Remove (or set to false) for the real launch.
NEXT_PUBLIC_PREVIEW_MODE=
